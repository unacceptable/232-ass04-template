{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "mingw32-make",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "osx": {
                "command": "make",
                "options": {
                    "cwd": "${workspaceFolder}",
                    "env": {
                        "PATH": "${env:HOME}/.bin:${env:PATH}"
                    }
                }
            },
            "linux": {
                "command": "make"
            }
        },
        {
            "label": "build (native clang, for lldb)",
            "type": "shell",
            "command": "mkdir -p bin && /usr/bin/gcc -g -Wall -Isrc -Ilib src/main.c src/code.c src/tests.c src/unity.c -o bin/main-native",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        }
    ]
}
